+pub fn cancel_close() {
+    if let Some(timer) = CLOSE_TIMER.with(|timer| timer.borrow_mut().take()) {
+        timer.remove();
+    }
+    CLOSING.set(false);
+    with_window(|w| {
+        w.box_wrapper.remove_css_class("shoji-closing");
+        w.box_wrapper.set_sensitive(true);
+    });
+}
+
 pub fn quit(app: &Application, cancelled: bool) {
+    if CLOSING.replace(true) {
+        return;
+    }
+
+    let animate = get_theme() == "shoji"
+        && with_window(|w| w.window.is_mapped())
+        && gtk4::Settings::default().is_some_and(|settings| settings.is_gtk_enable_animations());
+    if animate {
+        with_window(|w| {
+            w.box_wrapper.add_css_class("shoji-closing");
+            w.box_wrapper.set_sensitive(false);
+        });
+        let app = app.clone();
+        // Leave one frame after the 160 ms CSS animation before unmapping.
+        let timer = glib::timeout_add_local_once(std::time::Duration::from_millis(180), move || {
+            CLOSE_TIMER.with(|timer| timer.borrow_mut().take());
+            finish_quit(&app, cancelled);
+        });
+        CLOSE_TIMER.with(|pending| *pending.borrow_mut() = Some(timer));
+    } else {
+        finish_quit(app, cancelled);
+    }
+}
