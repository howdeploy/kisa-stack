+QStringList NotificationServer::allowedApplications() const {
+	return this->mAllowedApplications;
+}
+
+void NotificationServer::setAllowedApplications(const QStringList& applications) {
+	if (applications.size() > 1024) return;
+	auto normalized = QStringList();
+	for (const auto& application: applications) {
+		if (application.size() > 256 || application.contains(QChar::Null)) return;
+		auto key = applicationKey(application);
+		if (!key.isEmpty() && !normalized.contains(key)) normalized.append(key);
+	}
+	normalized.sort();
+	if (normalized == this->mAllowedApplications) return;
+	this->mAllowedApplications = normalized;
+	this->discardBlocked();
+	this->publishInhibition();
+}
+
+bool NotificationServer::applicationAllowed(const QString& desktopEntry, const QString& appName) const {
+	// A supplied desktop id takes priority over the unstructured display name.
+	return this->mAllowedApplications.contains(applicationKey(
+	    desktopEntry.isEmpty() ? appName : desktopEntry
+	));
+}
+
+bool NotificationServer::clientInhibited(const QString& service) {
+	if (!this->clientApplications.contains(service)) {
+		if (this->clientApplications.size() >= 1024) return this->mInhibited;
+		auto identities = QStringList();
+		auto* interface = QDBusConnection::sessionBus().interface();
+		if (interface) {
+			const auto pid = interface->servicePid(service);
+			if (pid.isValid()) {
+				const auto executable = QFileInfo(QStringLiteral("/proc/%1/exe").arg(pid.value())).symLinkTarget();
+				if (!executable.isEmpty()) identities.append(applicationKey(QFileInfo(executable).fileName()));
+			}
+		}
+		this->clientApplications.insert(service, identities);
+		this->clientWatcher.addWatchedService(service);
+	}
+	if (!this->mInhibited) return false;
+	for (const auto& identity: this->clientApplications.value(service)) {
+		if (this->mAllowedApplications.contains(identity)) return false;
+	}
+	return true;
+}
+
+void NotificationServer::discardBlocked() {
+	if (!this->mInhibited) return;
+	const auto ids = this->idMap.keys();
+	for (auto id: ids) {
+		auto* notification = this->idMap.value(id);
+		if (!notification) continue;
+		if (!this->applicationAllowed(notification->bindableDesktopEntry().value(),
+		                              notification->bindableAppName().value())) {
+			this->deleteNotification(notification, NotificationCloseReason::Expired);
+		}
+	}
+}
+
+void NotificationServer::setInhibited(bool inhibited) {
+	if (inhibited == this->mInhibited) return;
+	this->mInhibited = inhibited;
+	emit this->inhibitedChanged();
+	this->discardBlocked();
+	this->publishInhibition();
+}
+
+void NotificationServer::publishInhibition() {
+	// A global true/false broadcast would overwrite the exceptions in clients' caches.
+	for (const auto& service: this->clientApplications.keys()) {
+		auto message = QDBusMessage::createTargetedSignal(
+		    service, "/org/freedesktop/Notifications", "org.freedesktop.DBus.Properties", "PropertiesChanged"
+		);
+		message.setArguments({QStringLiteral("org.freedesktop.Notifications"),
+		                      QVariantMap {{QStringLiteral("Inhibited"), this->clientInhibited(service)}},
+		                      QStringList {}});
+		if (!QDBusConnection::sessionBus().send(message))
+			qCWarning(logNotifications) << "Could not publish notification inhibition change.";
+	}
+}
