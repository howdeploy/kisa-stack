+    std::set<std::string> targets;
+    for (const auto& [screen, background] : ctx.settings.general.screenBackgrounds) {
+	targets.insert (screen);
+    }
+    for (const auto& group : ctx.settings.general.spanGroups) {
+	targets.insert (group.screens.begin (), group.screens.end ());
