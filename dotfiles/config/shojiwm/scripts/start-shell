#!/usr/bin/env bash
set -euo pipefail
# This is a local, trusted shell file. Keep credentials in each provider's CLI.
settings="${XDG_CONFIG_HOME:-$HOME/.config}/shoji-shell/integrations.env"
if [[ -f "$settings" ]]; then
    set -a
    source "$settings"
    set +a
fi
quickshell_bin="${SHOJI_QUICKSHELL:-${XDG_DATA_HOME:-$HOME/.local/share}/shoji-shell/quickshell/bin/quickshell}"
if [[ ! -x "$quickshell_bin" ]]; then
    echo 'Missing patched Quickshell. Build/install dotfiles/scripts/build-quickshell.sh first.' >&2
    exit 1
fi
export PATH="$(dirname -- "$quickshell_bin"):$PATH"
exec "$quickshell_bin" --no-duplicate --path "${XDG_CONFIG_HOME:-$HOME/.config}/shoji-shell"
