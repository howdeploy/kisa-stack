# Copy to integrations.env OUTSIDE the repository; restart the shell to apply.
# No credential values belong here. Each CLI uses the installing user's login.
SHOJI_ENABLE_GITHUB=0
SHOJI_ENABLE_VAST=0
SHOJI_ENABLE_LIMITS=0
SHOJI_ENABLE_SESSIONS=0
SHOJI_ENABLE_HERMES=0
SHOJI_ENABLE_WEATHER=0
# SHOJI_PRIMARY_OUTPUT=DP-1
# SHOJI_WALLPAPERS="$HOME/Pictures/Wallpapers"
# SHOJI_HERMES_ROOT="$HOME/.hermes/hermes-agent"
# Exactly two named locations; coordinates are supplied by the installing user.
# SHOJI_WEATHER_CITIES='[["first","First city",0,0],["second","Second city",0,0]]'
